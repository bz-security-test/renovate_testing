{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":prHourlyLimitNone",
    ":enableVulnerabilityAlerts"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies update 1",
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules update 1",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker base images update 1",
      "automerge": true
    },
    {
      "description": "Clean-room manifests: auto-merge sha/digest refreshes (tag stays the same)",
      "matchFileNames": ["domains/third-party-apps/**"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Clean-room manifests: never touch the tag (patch/minor/major are deliberate manual entries)",
      "matchFileNames": ["domains/third-party-apps/**"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^domains/third-party-apps/.*\\.yaml$/"],
      "matchStrings": [
        "source:\\s*\"?(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}